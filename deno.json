{
  "name": "@hoedown/gateway",
  "exports": "./src/battle/runner.ts",
  "tasks": {
    "test": "deno test -A",
    "serve": "deno run -A src/server.ts",
    "build:sprites": "deno run -A src/sprites/pipeline.ts",
    "protocol:drift": "deno run --allow-read --allow-run scripts/check_protocol_drift.ts"
  },
  "imports": {
    "@bufbuild/protobuf": "npm:@bufbuild/protobuf@2.13.0",
    "@bufbuild/protobuf/codegenv2": "npm:@bufbuild/protobuf@2.13.0/codegenv2",
    "@hono/hono": "jsr:@hono/hono@^4.12.27",
    "@pkmn/client": "npm:@pkmn/client@^0.7.3",
    "@pkmn/data": "npm:@pkmn/data@^0.10.11",
    "@pkmn/dex": "npm:@pkmn/dex@^0.10.11",
    "@pkmn/protocol": "npm:@pkmn/protocol@^0.7.3",
    "@pkmn/sim": "npm:@pkmn/sim@^0.10.11",
    "@std/assert": "jsr:@std/assert",
    "@std/path": "jsr:@std/path@^1"
  },
  "fmt": { "lineWidth": 100, "exclude": ["src/ws/gen"] },
  "lint": { "rules": { "tags": ["recommended"] }, "exclude": ["src/ws/gen"] }
}
